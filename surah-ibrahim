        hair.style.background = ['#2c1810', '#4a2e14', '#1a0f08', '#3d2817', '#5d3a1a', '#6b4423'][i % 6];
        const eyes = document.createElement('div');
        eyes.className = 'student-eyes';
        eyes.innerHTML = '<div class="student-eye"></div><div class="student-eye"></div>';
        head.appendChild(hair);
        head.appendChild(eyes);
        
        const body = document.createElement('div');
        body.className = 'student-body';
        body.style.background = `linear-gradient(180deg, ${student.color}, ${adjustColor(student.color, -30)})`;
        
        const deskSurface = document.createElement('div');
