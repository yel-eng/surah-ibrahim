        figure.appendChild(head);
        figure.appendChild(body);
        desk.appendChild(question);
        desk.appendChild(figure);
        desk.appendChild(deskSurface);
        grid.appendChild(desk);
    });
}

function adjustColor(hex, amount) {
    const num = parseInt(hex.slice(1), 16);
    const r = Math.min(255, Math.max(0, (num >> 16) + amount));
    const g = Math.min(255, Math.max(0, ((num >> 8) & 0x00FF) + amount));
    const b = Math.min(255, Math.max(0, (num & 0x0000FF) + amount));
    return `#${(r << 16 | g << 8 | b).toString(16).padStart(6, '0')}`;
}

function showTeacherQuestion(text, callback) {
    const speech = document.getElementById('teacherSpeech');
    const teacher = document.getElementById('teacherFigure');
    
    speech.textContent = text;
    speech.classList.add('show');
    teacher.classList.add('teacher-speaking');
    
    speak(text, true, () => {
        teacher.classList.remove('teacher-speaking');
        setTimeout(() => {
            speech.classList.remove('show');
            if (callback) callback();
        }, 500);
    });
}

function selectStudent(index) {
    if (isSpeaking) return;
    
    currentStudent = index;
    const section = sections[currentSection];
    const student = section.students[index];
    
    const questionEl = document.querySelectorAll('.student-question')[index];
    questionEl.classList.add('speaking');
    
    speak(student.question, false, () => {
        questionEl.classList.remove('speaking');
        
        document.getElementById('questionText').textContent = student.question;
        document.getElementById('answerTitleText').textContent = 'إجابة المعلم';
        document.getElementById('answerText').textContent = student.answer;
        
        document.getElementById('questionScreen').classList.add('active');
        document.getElementById('audioPlayer').classList.remove('show');
        document.getElementById('answerDisplay').classList.remove('show');
        document.getElementById('nextBtn').style.display = 'none';
        document.getElementById('choiceButtons').style.display = 'flex';
    });
}

function backToClassroom() {
    document.getElementById('questionScreen').classList.remove('active');
    stopAudio();
    speechSynthesis.cancel();
}

function chooseListen() {
    const section = sections[currentSection];
    document.getElementById('verseDisplay').textContent = section.verse || 'بسم الله الرحمن الرحيم';
    document.getElementById('audioPlayer').classList.add('show');
    document.getElementById('choiceButtons').style.display = 'none';
    
    audioEl.src = section.audioUrl || 'https://everyayah.com/data/Alafasy_128kbps/014024.mp3';
    
    setTimeout(() => {
        toggleAudio();
    }, 500);
}

function chooseExplain() {
    const student = sections[currentSection].students[currentStudent];
    document.getElementById('answerDisplay').classList.add('show');
    document.getElementById('choiceButtons').style.display = 'none';
    
    speak(student.answer, true, () => {
        setTimeout(() => {
            document.getElementById('nextBtn').style.display = 'inline-block';
            addAskAgainButton();
        }, 1000);
    });
}

function addAskAgainButton() {
    const choiceButtons = document.getElementById('choiceButtons');
    if (!document.getElementById('askAgainBtn')) {
        const btn = document.createElement('button');
        btn.className = 'choice-btn ask-again';
        btn.id = 'askAgainBtn';
        btn.innerHTML = '<span class="choice-icon">🔄</span> اسأل مرة أخرى';
        btn.onclick = () => askAgain();
        choiceButtons.appendChild(btn);
        choiceButtons.style.display = 'flex';
    }
}

function askAgain() {
    const student = sections[currentSection].students[currentStudent];
    document.getElementById('answerDisplay').classList.remove('show');
    document.getElementById('nextBtn').style.display = 'none';
    document.getElementById('askAgainBtn')?.remove();
    document.getElementById('choiceButtons').style.display = 'none';
    
    speak(student.question, false, () => {
        setTimeout(() => {
            document.getElementById('answerDisplay').classList.add('show');
            speak(student.answer, true, () => {
                setTimeout(() => {
                    document.getElementById('nextBtn').style.display = 'inline-block';
                    addAskAgainButton();
                }, 1000);
            });
        }, 500);
    });
}

function toggleAudio() {
    const btn = document.getElementById('playBtn');
    
    if (audioPlaying) {
        audioEl.pause();
        btn.textContent = '▶️';
        btn.classList.remove('playing');
        audioPlaying = false;
    } else {
        audioEl.play().then(() => {
            btn.textContent = '⏸️';
            btn.classList.add('playing');
            audioPlaying = true;
        }).catch(e => {
            alert('تعذر تشغيل الصوت. تأكد من اتصالك بالإنترنت.');
        });
    }
}

function stopAudio() {
    audioEl.pause();
    audioEl.currentTime = 0;
    audioPlaying = false;
    const btn = document.getElementById('playBtn');
    if (btn) {
        btn.textContent = '▶️';
        btn.classList.remove('playing');
    }
}

audioEl.addEventListener('ended', () => {
    audioPlaying = false;
    const btn = document.getElementById('playBtn');
    if (btn) {
        btn.textContent = '▶️';
        btn.classList.remove('playing');
    }
    
    setTimeout(() => {
        document.getElementById('nextBtn').style.display = 'inline-block';
    }, 1000);
});

// Initialize
init();
</script>
</body>
</html>
