function toggleMenu() {
    const toggle = document.getElementById('menuToggle');
    const dropdown = document.getElementById('menuDropdown');
    toggle.classList.toggle('active');
    dropdown.classList.toggle('open');
}

function goToSection(sectionId) {
    const index = sections.findIndex(s => s.id === sectionId);
    if (index === -1) return;
    
    // Close menu
    toggleMenu();
    
    const landing = document.getElementById('landing');
    const classroom = document.getElementById('classroom');
    const questionScreen = document.getElementById('questionScreen');
    
    // Cancel any ongoing speech
    speechSynthesis.cancel();
    stopAudio();
    
    if (!landing.classList.contains('hidden')) {
        // Case 1: User is on landing page - open classroom with selected section
        currentSection = index;
        enterStudentView();
    } else if (questionScreen.classList.contains('active')) {
        // Case 2: User is on question screen - go back to classroom then load section
        questionScreen.classList.remove('active');
        currentSection = index;
        setTimeout(() => {
            loadSection(index);
        }, 400);
    } else if (classroom.classList.contains('active')) {
        // Case 3: User is already in classroom - just load the new section
        currentSection = index;
        loadSection(index);
    }
}

function enterStudentView() {
    document.getElementById('landing').classList.add('hidden');
    setTimeout(() => {
        document.getElementById('classroom').classList.add('active');
        loadSection(currentSection);
    }, 800);
}

function loadSection(index) {
    currentSection = index;
    const section = sections[index];
    
    // Update blackboard
    document.getElementById('boardTitle').textContent = section.boardTitle;
    document.getElementById('boardSubtitle').textContent = section.boardSubtitle;
    
    // Render students
    renderStudents(section);
    
    // Hide teacher speech initially
    const speech = document.getElementById('teacherSpeech');
    speech.classList.remove('show');
    
    // Start teacher intro after a short delay
    setTimeout(() => {
        showTeacherQuestion(section.teacherIntro, () => {
            // After teacher finishes, show student questions
            setTimeout(() => {
                document.querySelectorAll('.student-question').forEach((q, i) => {
                    setTimeout(() => q.classList.add('show'), i * 250);
                });
            }, 400);
        });
    }, 800);
}

