<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>سورة إبراهيم - عرض تفاعلي تعليمي</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

:root {
    --gold: #d4af37;
    --gold-light: #f4e5a1;
    --deep-blue: #0a1628;
    --royal-blue: #1e3a5f;
    --emerald: #0d7377;
    --cream: #fdf8ef;
    --warm: #f5e6d3;
    --teacher-color: #2c5f7c;
    --student-color: #c0392b;
}

body {
    font-family: 'Segoe UI', Tahoma, sans-serif;
    background: var(--deep-blue);
    overflow-x: hidden;
    height: 100vh;
    width: 100vw;
    color: white;
    position: fixed;
}

/* ============ TOP MENU ============ */
.top-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(180deg, rgba(10,22,40,0.98) 0%, rgba(10,22,40,0.95) 100%);
    backdrop-filter: blur(20px);
    border-bottom: 2px solid var(--gold);
    z-index: 1000;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
}

.menu-logo {
    font-size: 1.2rem;
    font-weight: bold;
    color: var(--gold);
    margin-left: 1rem;
    white-space: nowrap;
}

.menu-toggle {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    border: none;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: all 0.3s;
}

.menu-toggle span {
    width: 20px;
    height: 2px;
    background: var(--deep-blue);
    transition: all 0.3s;
}

.menu-toggle.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
.menu-toggle.active span:nth-child(2) { opacity: 0; }
.menu-toggle.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

.menu-dropdown {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, rgba(10,22,40,0.98), rgba(10,22,40,0.95));
    backdrop-filter: blur(20px);
    border-bottom: 2px solid var(--gold);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
    z-index: 999;
}

.menu-dropdown.open {
    max-height: 80vh;
    overflow-y: auto;
}

.menu-item {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(212,175,55,0.2);
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: white;
    font-size: 1.05rem;
}

.menu-item:hover, .menu-item.active {
    background: rgba(212,175,55,0.15);
    padding-right: 2rem;
}

.menu-item-icon {
    width: 35px;
    height: 35px;
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
}

.menu-item-text {
    flex: 1;
}

/* ============ LANDING PAGE ============ */
.landing {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at center, #1a2a4a 0%, #0a1628 70%);
    z-index: 500;
    transition: opacity 1s, transform 1s;
    padding: 1rem;
    overflow-y: auto;
}

.landing.hidden {
    opacity: 0;
    transform: scale(1.1);
    pointer-events: none;
}

.landing-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
}

.landing-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
        radial-gradient(circle at 20% 30%, rgba(212,175,55,0.15) 0%, transparent 40%),
        radial-gradient(circle at 80% 70%, rgba(13,115,119,0.15) 0%, transparent 40%);
    animation: bgPulse 8s ease-in-out infinite;
}

@keyframes bgPulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
}

.landing-particles {
    position: absolute;
    inset: 0;
}

.particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--gold);
    border-radius: 50%;
    animation: particleFloat 15s infinite linear;
    opacity: 0.6;
}

@keyframes particleFloat {
    0% { transform: translateY(100vh) translateX(0); opacity: 0; }
    10% { opacity: 0.6; }
    90% { opacity: 0.6; }
    100% { transform: translateY(-100px) translateX(100px); opacity: 0; }
}

.landing-content {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 900px;
    width: 100%;
    padding: 1rem;
}

.lesson-badge {
    display: inline-block;
    padding: 8px 24px;
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    color: var(--deep-blue);
    border-radius: 30px;
    font-weight: bold;
    font-size: 1rem;
    margin-bottom: 1rem;
    opacity: 0;
    animation: fadeUp 1s ease 0.5s forwards;
    box-shadow: 0 10px 30px rgba(212,175,55,0.4);
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

.main-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 900;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 50%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.8rem;
    opacity: 0;
    animation: titleReveal 1.5s ease 0.7s forwards;
    letter-spacing: 2px;
}

@keyframes titleReveal {
    from { opacity: 0; transform: scale(0.8); filter: blur(10px); }
    to { opacity: 1; transform: scale(1); filter: blur(0); }
}

.subtitle {
    font-size: clamp(1rem, 3vw, 1.5rem);
    color: rgba(255,255,255,0.8);
    margin-bottom: 0.3rem;
    opacity: 0;
    animation: fadeUp 1s ease 1s forwards;
}

.verse-range {
    font-size: clamp(0.9rem, 2.5vw, 1.2rem);
    color: var(--gold-light);
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 1s ease 1.2s forwards;
}

.view-selector {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 1s ease 1.4s forwards;
}

.view-card {
    width: 260px;
    padding: 1.5rem;
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(20px);
    border: 2px solid rgba(212,175,55,0.3);
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.view-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(212,175,55,0.1), transparent);
    opacity: 0;
    transition: opacity 0.4s;
}

.view-card:hover:not(.disabled)::before { opacity: 1; }

.view-card:hover:not(.disabled) {
    transform: translateY(-8px);
    border-color: var(--gold);
    box-shadow: 0 20px 60px rgba(212,175,55,0.3);
}

.view-card.disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.view-card.disabled::after {
    content: 'قريباً';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-15deg);
    background: rgba(0,0,0,0.8);
    color: var(--gold);
    padding: 8px 25px;
    border-radius: 30px;
    font-weight: bold;
    font-size: 1.1rem;
    border: 2px solid var(--gold);
}

.view-icon {
    font-size: 3rem;
    margin-bottom: 0.8rem;
    display: block;
}

.view-title {
    font-size: 1.2rem;
    font-weight: bold;
    color: var(--gold-light);
    margin-bottom: 0.4rem;
}

.view-desc {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.6);
}

/* ============ CLASSROOM SCENE ============ */
.classroom {
    position: fixed;
    inset: 0;
    top: 60px;
    background: linear-gradient(180deg, #3d2817 0%, #2a1810 50%, #1a0f08 100%);
    display: none;
    opacity: 0;
    transition: opacity 0.8s;
    overflow: hidden;
}

.classroom.active {
    display: block;
    opacity: 1;
}

.classroom-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(61,40,23,0.95) 0%, rgba(42,24,16,0.98) 100%);
}

.classroom-floor {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 30%;
    background: repeating-linear-gradient(
        90deg,
        #5d3a1a 0px,
        #5d3a1a 80px,
        #4a2e14 80px,
        #4a2e14 82px
    );
    opacity: 0.3;
}

.blackboard {
    position: absolute;
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    width: 85%;
    max-width: 700px;
    height: 32%;
    background: linear-gradient(180deg, #1a3a2a 0%, #0f2818 100%);
    border: 12px solid #5d3a1a;
    border-radius: 8px;
    box-shadow: 
        inset 0 0 40px rgba(0,0,0,0.6),
        0 15px 40px rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
}

.blackboard::before {
    content: '';
    position: absolute;
    bottom: -25px;
    left: 10%;
    right: 10%;
    height: 15px;
    background: linear-gradient(180deg, #8b6f47, #5d3a1a);
    border-radius: 3px;
}

.blackboard-content {
    text-align: center;
    color: #f4e5a1;
    font-family: 'Amiri', serif;
}

.blackboard-title {
    font-size: clamp(1.3rem, 4vw, 2.2rem);
    font-weight: bold;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 15px rgba(244,229,161,0.5);
}

.blackboard-subtitle {
    font-size: clamp(0.9rem, 2.5vw, 1.2rem);
    opacity: 0.9;
}

/* Teacher */
.teacher-container {
    position: absolute;
    bottom: 32%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.teacher-figure {
    position: relative;
    width: 140px;
    height: 220px;
    animation: teacherBreathe 4s ease-in-out infinite;
}

@keyframes teacherBreathe {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
}

.teacher-head {
    width: 80px;
    height: 90px;
    background: linear-gradient(180deg, #e8b896 0%, #d49a78 100%);
    border-radius: 50% 50% 45% 45%;
    margin: 0 auto;
    position: relative;
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
}

.teacher-beard {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 35px;
    background: linear-gradient(180deg, #4a3728, #2c1810);
    border-radius: 0 0 50% 50%;
}

.teacher-ghutra {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 90px;
    height: 40px;
    background: white;
    border-radius: 50% 50% 30% 30%;
    box-shadow: 0 3px 10px rgba(0,0,0,0.2);
}

.teacher-ghutra::after {
    content: '';
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 85px;
    height: 8px;
    background: #c0392b;
    border-radius: 4px;
}

.teacher-eyes {
    position: absolute;
    top: 35px;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 15px;
}

.teacher-eye {
    width: 10px;
    height: 12px;
    background: white;
    border-radius: 50%;
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.2);
}

.teacher-eye::after {
    content: '';
    position: absolute;
    width: 6px;
    height: 7px;
    background: #1a1a1a;
    border-radius: 50%;
    top: 2px;
    left: 2px;
    animation: eyeMove 5s ease-in-out infinite;
}

@keyframes eyeMove {
    0%, 100% { transform: translate(0, 0); }
    25% { transform: translate(2px, -1px); }
    50% { transform: translate(-2px, 0); }
    75% { transform: translate(1px, 1px); }
}

.teacher-mouth {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 20px;
    height: 6px;
    background: #8b4513;
    border-radius: 0 0 12px 12px;
    transition: all 0.15s;
    z-index: 5;
}

.teacher-speaking .teacher-mouth {
    animation: teacherTalk 0.25s ease-in-out infinite;
}

@keyframes teacherTalk {
    0%, 100% { height: 6px; width: 20px; border-radius: 0 0 12px 12px; }
    50% { height: 12px; width: 16px; border-radius: 50%; }
}

.teacher-body {
    width: 110px;
    height: 120px;
    background: linear-gradient(180deg, #2c3e50 0%, #1a252f 100%);
    margin: -8px auto 0;
    border-radius: 50px 50px 0 0;
    position: relative;
    box-shadow: 0 8px 25px rgba(0,0,0,0.4);
}

.teacher-body::before {
    content: '';
    position: absolute;
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    width: 25px;
    height: 70px;
    background: linear-gradient(180deg, #d4af37, #b8941f);
    border-radius: 4px;
}

.teacher-name-tag {
    margin-top: 10px;
    padding: 6px 18px;
    background: linear-gradient(135deg, var(--teacher-color), #1a3a4f);
    border: 2px solid var(--gold);
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: bold;
    color: white;
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
}

/* ============ STUDENTS GRID ============ */
.students-grid {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 32%;
    padding: 0.5rem;
    z-index: 10;
    display: grid;
    gap: 0.4rem;
    align-items: end;
    justify-items: center;
}

.students-grid.layout-8 {
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
}

.students-grid.layout-6 {
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
}

.students-grid.layout-4 {
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
}

.students-grid.layout-5 {
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
}

.student-desk {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    transition: all 0.5s;
}

.student-question {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    color: var(--deep-blue);
    padding: 5px 10px;
    border-radius: 12px;
    font-size: 0.7rem;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(212,175,55,0.5);
    opacity: 0;
    transition: all 0.4s;
    z-index: 30;
    max-width: 120px;
    text-align: center;
    line-height: 1.3;
    border: 2px solid white;
    margin-bottom: 5px;
}

.student-question:hover, .student-question:active {
    transform: translateX(-50%) scale(1.1);
    box-shadow: 0 8px 25px rgba(212,175,55,0.8);
}

.student-question.show {
    opacity: 1;
    animation: questionPop 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.student-question.speaking {
    animation: questionSpeak 0.5s ease-in-out infinite;
    background: linear-gradient(135deg, #e74c3c, #c0392b);
    color: white;
}

@keyframes questionSpeak {
    0%, 100% { transform: translateX(-50%) scale(1); }
    50% { transform: translateX(-50%) scale(1.15); }
}

@keyframes questionPop {
    0% { transform: translateX(-50%) scale(0) translateY(20px); }
    100% { transform: translateX(-50%) scale(1) translateY(0); }
}

.student-figure {
    width: 100%;
    max-width: 70px;
    height: auto;
    aspect-ratio: 2/3;
    position: relative;
    animation: studentBreathe 3s ease-in-out infinite;
}

@keyframes studentBreathe {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
}

.student-head {
    width: 60%;
    aspect-ratio: 1/1.1;
    background: linear-gradient(180deg, #e8b896 0%, #d49a78 100%);
    border-radius: 50% 50% 45% 45%;
    margin: 0 auto;
    position: relative;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.student-hair {
    position: absolute;
    top: -5%;
    left: 50%;
    transform: translateX(-50%);
    width: 110%;
    height: 40%;
    border-radius: 50% 50% 0 0;
}

.student-eyes {
    position: absolute;
    top: 40%;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 15%;
}

.student-eye {
    width: 12%;
    aspect-ratio: 1/1.2;
    background: #1a1a1a;
    border-radius: 50%;
}

.student-body {
    width: 75%;
    height: 50%;
    margin: -5% auto 0;
    border-radius: 35% 35% 0 0;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.student-desk-surface {
    width: 90%;
    max-width: 80px;
    height: 6px;
    background: linear-gradient(180deg, #8b6f47, #5d3a1a);
    border-radius: 3px;
    margin-top: 2px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.4);
}

/* Teacher Speech Bubble */
.teacher-speech {
    position: absolute;
    bottom: 55%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255,255,255,0.98);
    color: var(--deep-blue);
    padding: 1rem 1.5rem;
    border-radius: 20px;
    font-size: clamp(0.9rem, 2.5vw, 1.2rem);
    font-weight: bold;
    max-width: 90%;
    text-align: center;
    box-shadow: 0 15px 40px rgba(0,0,0,0.5);
    opacity: 0;
    transition: all 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    z-index: 50;
    border: 3px solid var(--gold);
    line-height: 1.6;
}

.teacher-speech::after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    border: 12px solid transparent;
    border-top-color: rgba(255,255,255,0.98);
}

.teacher-speech.show {
    opacity: 1;
    transform: translateX(-50%) translateY(-5px);
}

/* ============ QUESTION SCREEN ============ */
.question-screen {
    position: fixed;
    inset: 0;
    top: 60px;
    background: radial-gradient(ellipse at center, #1a2a4a 0%, #0a1628 100%);
    display: none;
    opacity: 0;
    transition: opacity 0.8s;
    z-index: 100;
    padding: 1rem;
    overflow-y: auto;
}

.question-screen.active {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    opacity: 1;
    padding-top: 2rem;
}

.question-container {
    max-width: 800px;
    width: 100%;
    text-align: center;
}

.question-card {
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(20px);
    border: 2px solid rgba(212,175,55,0.3);
    border-radius: 25px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 15px 40px rgba(0,0,0,0.5);
}

.question-text {
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: white;
    margin-bottom: 1.5rem;
    line-height: 1.6;
}

.choice-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.choice-btn {
    padding: 1rem 1.5rem;
    font-size: clamp(0.9rem, 2.5vw, 1.1rem);
    font-weight: bold;
    border: none;
    border-radius: 15px;
    cursor: pointer;
    transition: all 0.3s;
    font-family: inherit;
    position: relative;
    overflow: hidden;
    min-width: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.choice-btn.listen {
    background: linear-gradient(135deg, #0d7377, #14a3a8);
    color: white;
    box-shadow: 0 8px 25px rgba(13,115,119,0.5);
}

.choice-btn.listen:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 12px 30px rgba(13,115,119,0.7);
}

.choice-btn.explain {
    background: linear-gradient(135deg, var(--gold), #b8941f);
    color: var(--deep-blue);
    box-shadow: 0 8px 25px rgba(212,175,55,0.5);
}

.choice-btn.explain:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 12px 30px rgba(212,175,55,0.7);
}

.choice-btn.ask-again {
    background: linear-gradient(135deg, #9b59b6, #8e44ad);
    color: white;
    box-shadow: 0 8px 25px rgba(155,89,182,0.5);
