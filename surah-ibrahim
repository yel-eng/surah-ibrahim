// ============ IMPROVED VOICE LOADING ============
function loadVoices() {
    const voices = speechSynthesis.getVoices();
    if (voices.length === 0) return;
    
    // Priority list for best Arabic voices (more natural sounding)
    const voicePriority = [
        // Google voices (most natural)
        v => v.name === 'Google العربية' || v.name === 'Google Arabic',
        v => v.lang === 'ar-SA' && v.name.includes('Google'),
        v => v.lang === 'ar' && v.name.includes('Google'),
        // Microsoft voices
        v => v.name === 'Microsoft Hoda' || v.name === 'Microsoft Naayf',
        v => v.lang === 'ar-SA' && v.name.includes('Microsoft'),
        // Saudi specific
        v => v.lang === 'ar-SA',
        // Other Arabic
        v => v.lang.startsWith('ar') && v.name.includes('Female'),
        v => v.lang.startsWith('ar') && v.name.includes('Male'),
        v => v.lang.startsWith('ar')
    ];
    
    // Find best teacher voice (prefer male, deeper)
    for (const check of voicePriority) {
        const found = voices.find(v => check(v) && (!v.name.includes('Female') || v.name.includes('Naayf')));
        if (found) {
            teacherVoice = found;
            break;
        }
    }
    
    // Find best student voice (prefer female, higher pitch)
    for (const check of voicePriority) {
        const found = voices.find(v => check(v) && (v.name.includes('Female') || v.name.includes('Hoda') || v.name.includes('Zira')));
        if (found) {
            studentVoice = found;
            break;
        }
    }
    
    // Fallback
    if (!teacherVoice) teacherVoice = voices.find(v => v.lang.startsWith('ar')) || voices[0];
    if (!studentVoice) studentVoice = voices.find(v => v.lang.startsWith('ar')) || voices[0];
    
    console.log('Teacher voice:', teacherVoice?.name, teacherVoice?.lang);
    console.log('Student voice:', studentVoice?.name, studentVoice?.lang);
}

if (speechSynthesis.onvoiceschanged !== undefined) {
    speechSynthesis.onvoiceschanged = loadVoices;
}

// ============ IMPROVED SPEECH FUNCTION ============
function speak(text, isTeacher = true, callback) {
    if (!('speechSynthesis' in window)) {
        if (callback) setTimeout(callback, 100);
        return;
    }
    
    speechSynthesis.cancel();
    
    // Split long text into sentences for more natural pauses
    const sentences = text.split(/(?<=[.!?،۔])\s+/);
    let currentIndex = 0;
    
    function speakNext() {
        if (currentIndex >= sentences.length) {
            hideSpeakerIndicator();
            isSpeaking = false;
            if (callback) callback();
            return;
        }
        
        const sentence = sentences[currentIndex].trim();
        if (!sentence) {
            currentIndex++;
            speakNext();
            return;
        }
        
        const utter = new SpeechSynthesisUtterance(sentence);
        utter.lang = 'ar-SA';
        
        // More natural settings
        if (isTeacher) {
            utter.rate = 0.92;  // Slightly slower for clarity
            utter.pitch = 0.9;  // Slightly deeper
            utter.volume = 1;
        } else {
            utter.rate = 0.95;
            utter.pitch = 1.1;  // Slightly higher for student
            utter.volume = 1;
        }
        
        // Use best available voice
        if (isTeacher && teacherVoice) utter.voice = teacherVoice;
        else if (!isTeacher && studentVoice) utter.voice = studentVoice;
        
        showSpeakerIndicator(isTeacher);
        isSpeaking = true;
        
        utter.onend = () => {
            currentIndex++;
            // Small pause between sentences for natural flow
            setTimeout(speakNext, 200);
        };
        
        utter.onerror = () => {
            hideSpeakerIndicator();
            isSpeaking = false;
            if (callback) callback();
        };
        
        speechSynthesis.speak(utter);
    }
    
    speakNext();
}

function showSpeakerIndicator(isTeacher) {
    const indicator = document.getElementById('speakerIndicator');
    const avatar = document.getElementById('speakerAvatar');
    const name = document.getElementById('speakerName');
    
    avatar.textContent = isTeacher ? '👨‍🏫' : '👨‍🎓';
    avatar.className = 'speaker-avatar ' + (isTeacher ? 'teacher' : 'student');
    name.textContent = isTeacher ? 'المعلم يتحدث...' : 'الطالب يسأل...';
    
    indicator.classList.add('show');
    
    if (isTeacher) {
        document.getElementById('teacherFigure').classList.add('teacher-speaking');
    }
}

function hideSpeakerIndicator() {
    document.getElementById('speakerIndicator').classList.remove('show');
    document.getElementById('teacherFigure').classList.remove('teacher-speaking');
}

